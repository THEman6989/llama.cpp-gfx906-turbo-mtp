+    int64_t  capacity  = 0;
+    int64_t  filled    = 0;
+    int64_t  ne0       = 0;
+    int64_t  ne2       = 0;
+    int64_t  ne3       = 0;      // stream dimension (ne[3]), 1 for single-slot
